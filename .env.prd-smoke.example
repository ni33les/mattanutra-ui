# Copy to .env.prd-smoke for local strict PRD smoke checks.
# Do not commit .env.prd-smoke or real secrets.

MATTANUTRA_ENV=prd
PRD_SITE_URL=https://mattanutra.com
PRD_DIGITALOCEAN_APP_NAME=mattanutra-ui-prd
PRD_DIGITALOCEAN_COMPONENT_NAME=mattanutra-ui-prd

# Admin/migration PRD database URL for smoke checks only.
# Runtime app config must continue to use pooled DB_URL, not a direct admin URL.
PRD_DB_URL=

# Required when PRD_SMOKE_VALIDATE_LINE=true.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Required when PRD_SMOKE_VALIDATE_WORKER_CREDENTIALS=true.
WORKER_ADVISOR_AGENT_API_KEY=
WORKER_ANALYTICS_AGENT_API_KEY=
WORKER_CARRIER_AGENT_API_KEY=
WORKER_CHAT_AGENT_API_KEY=
WORKER_COMMUNICATIONS_AGENT_API_KEY=
WORKER_CONTENT_AGENT_API_KEY=
WORKER_EMAIL_AGENT_API_KEY=
WORKER_FOOD_AGENT_API_KEY=
WORKER_FORMULATION_AGENT_API_KEY=
WORKER_HEALTHSCORE_AGENT_API_KEY=
WORKER_HOSTING_AGENT_API_KEY=
WORKER_PANYA_AGENT_API_KEY=
WORKER_PRODUCTS_AGENT_API_KEY=
WORKER_STOCK_AGENT_API_KEY=
